<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/screenContainer"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/bg_screen">

  <View
    android:layout_width="220dp"
    android:layout_height="220dp"
    android:layout_gravity="top|start"
    android:layout_marginStart="-64dp"
    android:layout_marginTop="-56dp"
    android:background="@drawable/bg_glow_navy" />

  <View
    android:layout_width="280dp"
    android:layout_height="280dp"
    android:layout_gravity="top|end"
    android:layout_marginTop="-20dp"
    android:layout_marginEnd="-88dp"
    android:background="@drawable/bg_glow_amber" />

  <ScrollView
    android:id="@+id/contentScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fadeScrollbars="false"
    android:scrollbars="none">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="24dp"
      android:paddingTop="20dp"
      android:paddingEnd="24dp"
      android:paddingBottom="24dp">

      <ImageButton
        android:id="@+id/backButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/story_back_cta"
        android:padding="8dp"
        android:src="?attr/homeAsUpIndicator"
        android:tint="@color/text_primary" />

      <ImageView
        android:id="@+id/storyImage"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="12dp"
        android:adjustViewBounds="true"
        android:background="@drawable/bg_hero_mask"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/blacksmith" />

      <TextView
        android:id="@+id/captionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_badge"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="@string/story_caption"
        android:textColor="@color/accent_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="4dp"
        android:text="@string/story_title"
        android:textColor="@color/text_primary"
        android:textSize="34sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/primaryBodyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/story_body_primary"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

      <TextView
        android:id="@+id/secondaryBodyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/story_body_secondary"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ProgressBar
          android:id="@+id/refreshProgress"
          style="?android:attr/progressBarStyleSmall"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:indeterminateTint="@color/accent_primary"
          android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/refreshButton"
          style="@style/Widget.ReRuneViewsExample.PrimaryButton"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:text="@string/story_refresh_cta" />
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
</FrameLayout>
