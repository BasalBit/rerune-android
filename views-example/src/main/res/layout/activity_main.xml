<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/swipeRefresh"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <FrameLayout
    android:id="@+id/screenContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <View
      android:layout_width="220dp"
      android:layout_height="220dp"
      android:layout_gravity="top|start"
      android:layout_marginStart="-64dp"
      android:layout_marginTop="-56dp"
      android:background="@drawable/bg_glow_navy" />

    <View
      android:layout_width="280dp"
      android:layout_height="280dp"
      android:layout_gravity="top|end"
      android:layout_marginTop="-20dp"
      android:layout_marginEnd="-88dp"
      android:background="@drawable/bg_glow_amber" />

    <LinearLayout
      android:id="@+id/contentColumn"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:clipToPadding="false"
      android:orientation="vertical"
      android:paddingStart="24dp"
      android:paddingTop="20dp"
      android:paddingEnd="24dp"
      android:paddingBottom="24dp">

      <TextView
        android:id="@+id/badgeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="@string/welcome_badge"
        android:textColor="@color/accent_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="4dp"
        android:text="@string/welcome_title"
        android:textColor="@color/text_primary"
        android:textSize="38sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/subtitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/welcome_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

      <ImageView
        android:id="@+id/heroImage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="22dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:background="@drawable/bg_hero_mask"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:minHeight="280dp"
        android:scaleType="centerCrop"
        android:src="@drawable/writer_orb" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="20dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
              android:id="@+id/localeLabel"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="@string/welcome_locale_label"
              android:textColor="@color/text_secondary"
              android:textSize="15sp" />

            <TextView
              android:id="@+id/localeValue"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:textColor="@color/text_primary"
              android:textSize="15sp"
              android:textStyle="bold" />
          </LinearLayout>

          <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@color/border_subtle" />

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
              android:id="@+id/lastSyncedLabel"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="@string/welcome_last_synced_label"
              android:textColor="@color/text_secondary"
              android:textSize="15sp" />

            <TextView
              android:id="@+id/lastSyncedValue"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:textColor="@color/text_primary"
              android:textSize="15sp"
              android:textStyle="bold" />
          </LinearLayout>
      </LinearLayout>

      <TextView
        android:id="@+id/refreshStateLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/welcome_refresh_state_idle"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/openStoryButton"
        style="@style/Widget.ReRuneViewsExample.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/welcome_open_story_cta" />
    </LinearLayout>
  </FrameLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
